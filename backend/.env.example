# Application
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1
JWT_SECRET=super_secret_jwt_key_for_development_change_in_production
JWT_EXPIRES_IN=1d

# Database (Amazon RDS PostgreSQL hoặc Local Docker)
DATABASE_URL="postgresql://astralfood_admin:astralfood_password_123@localhost:5432/astralfood_db?schema=public"

# AWS Credentials & Region (Singapore)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Amazon S3 (Lưu trữ ảnh & file tĩnh)
S3_BUCKET_MEDIA=astralfood-media-bucket-ap-southeast-1
S3_PRESIGNED_EXPIRES=300

# Amazon SQS (Hàng đợi xử lý đơn hàng bất đồng bộ)
SQS_ORDER_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/astralfood-orders-queue

# AI Copilot (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key
